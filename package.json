{
  "name": "screview",
  "version": "1.0.1",
  "description": "Catch junk AI agents leave in TypeScript and JavaScript.",
  "keywords": [
    "code-review",
    "ai",
    "static-analysis",
    "typescript",
    "ast"
  ],
  "license": "MIT",
  "author": "hopesf",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hopesf/screview.git"
  },
  "bugs": {
    "url": "https://github.com/hopesf/screview/issues"
  },
  "homepage": "https://github.com/hopesf/screview#readme",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "screview": "dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "fast-glob": "^3.3.3",
    "picocolors": "^1.1.1",
    "ts-morph": "^28.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "tsup": "^8.5.1",
    "typescript": "^5.8.2",
    "vitest": "^4.1.11"
  }
}
